# ============================================================
# Environment variables — copy values into:
#   - local dev:   .env.development  (vercel env pull or manual)
#   - Vercel:      Project Settings → Environment Variables
# NEVER put real secrets into files prefixed VITE_ — Vite inlines
# every VITE_* variable into the client bundle.
# ============================================================

# ---- Client (safe to expose) --------------------------------
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon key>

# ---- Server (API routes / scripts) --------------------------
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon key>
SUPABASE_SERVICE_ROLE_KEY=<service role key>   # server-only, bypasses RLS

# ---- Overdue cron (api/cron/overdue.js) ---------------------
# Vercel Cron sends this automatically as "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=<random string>                    # e.g. openssl rand -hex 32

# ---- Cloudflare R2 storage (server-only) --------------------
R2_BUCKET=<bucket>
R2_ACCESS_KEY_ID=<access key id>
R2_SECRET_ACCESS_KEY=<secret access key>
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
