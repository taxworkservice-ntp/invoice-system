# ============================================================
# Environment variables — copy values into:
#   - local dev:   .env.development  (vercel env pull or manual)
#   - Vercel:      Project Settings → Environment Variables
# NEVER put real secrets into files prefixed VITE_ — Vite inlines
# every VITE_* variable into the client bundle.
# ============================================================

# ---- Client (safe to expose) --------------------------------
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon key>

# ---- Server (API routes / scripts) --------------------------
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon key>
SUPABASE_SERVICE_ROLE_KEY=<service role key>   # server-only, bypasses RLS

# ---- Overdue cron (api/cron/overdue.js) ---------------------
# Vercel Cron sends this automatically as "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=<random string>                    # e.g. openssl rand -hex 32

# ---- Cloudflare R2 storage (server-only) --------------------
R2_BUCKET=<bucket>
R2_ACCESS_KEY_ID=<access key id>
R2_SECRET_ACCESS_KEY=<secret access key>
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com

# ============================================================
# Local dev without the server secrets
# ============================================================
# The secrets above are stored as "sensitive" in Vercel, so `vercel env pull`
# cannot download them. Two switches keep a local checkout fully working:
#
#   DEV_STORAGE_DIR   → the storage backend writes to disk instead of R2.
#                       Uploads/downloads work; nothing reaches the real bucket.
#   (no service-role key) → the API builds its Supabase client from the
#                       caller's own session (anon key + their JWT), so every
#                       query runs under RLS. The Supabase admin API (member
#                       and workspace management) stays unavailable.
#
# Delete DEV_STORAGE_DIR once the R2_* values are available.
# DEV_STORAGE_DIR=.local-storage
# DEV_STORAGE_SECRET=<any local string; signs local object URLs>
